<h1>Edit movie</h1>

<% @the_movie.errors.full_messages.each do |message| %>
  <p style="color: red;"><%= message %></p>
<% end %>


<%= form_with(model: @the_movie, method: :patch, data: { turbo: false }) do |form| %>
  
  <div>
    <%= form.label :title %>
    <%= form.text_field :title, { @the_movie.title } %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description, { rows: 3, value: @the_movie.description } %>
  </div>

  <%= form.button %>

