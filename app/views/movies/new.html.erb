<h1>New movie</h1>

<% @the_movie.errors.full_messages.each do |message| %>
  <p style="color: red;"><%= message %></p>
<% end %>

<%= form_with(model: @the_movie, data: { turbo: false }) do |form| %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :query_title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :query_description, { rows: 3 } %>
  </div>

  <%= form.button %>
<% end %>
